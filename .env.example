# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/visitor_slideshow

# Local Image Upload Directory (relative to project root or absolute path)
UPLOAD_DIR=./uploads

# Maximum File Size per photo in Bytes (e.g. 10MB = 10485760)
MAX_FILE_SIZE_BYTES=10485760

# Maximum Photos allowed per submission
MAX_FILES_COUNT=5

# Slideshow photo display duration in seconds (for Agent 2 Slideshow consumption)
SLIDESHOW_DURATION_SECONDS=6

# App Base URL (optional for absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
